# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# OpenRCT2 binary + vendored libs (scripts/setup_env.sh)
.vendor/

# Experiment data (large; summaries go to docs/ and results/)
runs/

# OpenRCT2 user data for experiment instances (created by game.py)
runtime/

# Intermediate animation frames (the GIF/WebP are kept)
results/*/frames/

# Video intermediates (frames and image sequences; scripts/make_videos.py rebuilds them)
results/video/ride_frames/
results/video/ride_seq/
results/video/search_frames/
results/video/search_seq/
results/video/*_log.txt
